# Copy to .env for local development and replace each placeholder.
# These values are build inputs, not a place for privileged/server-only credentials.
# Supabase mobile clients may use only the public publishable/anon key; never use a service-role/secret key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Any key placed in BuildConfig is extractable from the APK.
# Prefer a server-side proxy for privileged/production API keys.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Optional legacy multi-agent function key. Leave blank to disable that call until configured.
VIBESYNC_AGENT_API_KEY=
