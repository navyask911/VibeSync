# Copy to .env for local development and replace these placeholders.
# This file must contain only non-secret client configuration placeholders.
# Supabase Android clients may use only the public publishable/anon key.
# Never place service-role/secret keys, Gemini Developer API keys, partner keys,
# database passwords, or signing credentials in .env or BuildConfig.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
